# URL pública usada em canonical, sitemap e Open Graph.
# Em produção, defina na Netlify (Site configuration > Environment variables).
PUBLIC_SITE_URL=https://typing-game.netlify.app

# Conexão Postgres (Neon) usada pelo ranking global.
# Sem ela, a API responde 503 e o jogo mantém apenas recordes locais.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
