# URL pública (apenas a origem) usada em canonical, hreflang, sitemap, robots e Open Graph.
# Em produção, defina na Netlify (Site configuration > Environment variables) antes do build.
PUBLIC_SITE_URL=

# Banco do ranking.
# - Produção (Netlify): string do Neon, ex.: postgresql://usuario:senha@host/banco?sslmode=require
# - Local: deixe vazio em `npm run dev` para usar SQLite em .data/leaderboard.sqlite,
#   ou force um arquivo com sqlite:.data/meu-ranking.sqlite (também funciona no `npm run preview`).
# - Sem valor em produção, a API responde 503 e o jogo segue com recordes locais.
DATABASE_URL=
